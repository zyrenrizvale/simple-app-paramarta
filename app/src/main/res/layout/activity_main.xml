<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Floating Header -->
    <LinearLayout
        android:id="@+id/customHeader"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/bg_card"
        android:orientation="horizontal"
        android:gravity="center_vertical|end"
        android:paddingHorizontal="16dp"
        android:elevation="8dp"
        android:layout_alignParentTop="true">

        <ImageView
            android:id="@+id/ivSignal"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ic_signal_cellular"
            app:tint="@color/text_white" />

        <TextView
            android:id="@+id/tvNetworkSpeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:text="0 KB/s"
            android:textColor="@color/text_white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvBattery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:text="100%"
            android:textColor="@color/text_white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivBattery"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="16dp"
            android:src="@drawable/ic_battery_modern"
            app:tint="@color/text_white" />

        <ImageButton
            android:id="@+id/btnRotate"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="16dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_rotate_modern"
            app:tint="@color/text_white" />

        <ImageButton
            android:id="@+id/btnExit"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_exit_modern"
            app:tint="@color/color_gold" />
    </LinearLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/customHeader">
        
        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
            
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Token Fullscreen Overlay -->
    <RelativeLayout
        android:id="@+id/tokenOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_dark"
        android:clickable="true"
        android:focusable="true"
        android:elevation="10dp"
        android:visibility="gone">

        <!-- Removed CardView, used LinearLayout with bg_glass -->
        <LinearLayout
            android:id="@+id/cardToken"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_marginHorizontal="32dp"
            android:background="@drawable/bg_glass"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="32dp">

            <ImageView
                android:id="@+id/ivLogoToken"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_marginBottom="16dp"
                android:src="@drawable/logo"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/tvOverlayTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:gravity="center"
                android:text="TOKEN MASUK"
                android:textColor="@color/text_white"
                android:textSize="22sp"
                android:textStyle="bold" />
                
            <TextView
                android:id="@+id/tvOverlaySubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:gravity="center"
                android:text="Portal E-Learning SMA Paramartha"
                android:textColor="@color/text_gray"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etOverlayToken"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_edittext"
                android:gravity="center"
                android:hint="Masukkan Token"
                android:inputType="textPassword"
                android:paddingHorizontal="16dp"
                android:textColor="@color/text_white"
                android:textColorHint="@color/text_gray"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnOverlaySubmit"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:background="@drawable/bg_button"
                android:text="MASUK"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />
                
            <Button
                android:id="@+id/btnOverlayCancel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@android:color/transparent"
                android:text="Batal"
                android:textColor="@color/text_gray"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Bottom Security Text -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:orientation="horizontal">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_signal_cellular" 
                app:tint="@color/text_gray"
                android:layout_marginEnd="8dp"/>
            <TextView
                android:id="@+id/tvSecurityText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Protected by Paramartha Security System"
                android:textColor="@color/text_gray"
                android:textSize="12sp" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Splash Screen Overlay -->
    <RelativeLayout
        android:id="@+id/splashScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_dark"
        android:clickable="true"
        android:focusable="true"
        android:elevation="20dp"
        android:visibility="visible">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_centerInParent="true"
            android:src="@drawable/logo"
            android:scaleType="fitCenter" />
            
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="40dp"
            android:text="Memuat Sistem Keamanan..."
            android:textColor="@color/text_gray"
            android:textSize="14sp" />
    </RelativeLayout>
    <!-- Anti-Cheat Overlay -->
    <RelativeLayout
        android:id="@+id/antiCheatOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#D32F2F"
        android:clickable="true"
        android:focusable="true"
        android:elevation="30dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp">

            <ImageView
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@android:drawable/ic_dialog_alert"
                app:tint="#FFFFFF"
                android:layout_marginBottom="24dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PELANGGARAN TERDETEKSI!"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textAlignment="center"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/tvAntiCheatReason"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aplikasi terlarang atau modifikasi sistem terdeteksi."
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textAlignment="center"
                android:layout_marginBottom="32dp" />

            <Button
                android:id="@+id/btnExitCheat"
                android:layout_width="200dp"
                android:layout_height="50dp"
                android:backgroundTint="#B71C1C"
                android:text="KELUAR"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>
    </RelativeLayout>

</RelativeLayout>
